{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/tasks-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "",
    "Audience": "",
    "ExpiryMinutes": 60
  },
  "ApiVersioning": {
    "DefaultVersion": "1.0"
  },
  "Keycloak": {
    "Authority": "",
    "Audience": ""
  },
  "RabbitMq": {
    "Host": "",
    "Port": 5672,
    "Username": "",
    "Password": "",
    "VirtualHost": "/",
    "ExchangeName": "relatio.sales",
    "DealStageChangedQueue": "relatio.sales.deal.stage.changed",
    "DealStageChangedDlqQueue": "relatio.sales.deal.stage.changed.dlq",
    "OnboardingTaskCreatedRoutingKey": "task.onboarding.created",
    "OnboardingTaskFailedRoutingKey": "task.onboarding.failed"
  },
  "Consul": {
    "Url": "http://localhost:8500"
  },
  "AllowedHosts": "*"
}
