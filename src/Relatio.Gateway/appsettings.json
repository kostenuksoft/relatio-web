{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "",
    "Issuer": "",
    "Audience": ""
  },
  "RateLimiting": {
    "RequestsPerWindow": 30,
    "WindowSeconds": 60
  },
  "Consul": {
    "Url": "http://localhost:8500"
  },
  "Services": {
    "Identity": "http://relatio-identity:8080",
    "Customers": "http://relatio-customers:8080",
    "Contacts": "http://relatio-contacts:8080",
    "Sales": "http://relatio-sales:8080",
    "Tasks": "http://relatio-tasks:8080"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "customers-route": {
        "ClusterId": "customers-cluster",
        "AuthorizationPolicy": "Default",
        "RateLimiterPolicy": "gateway",
        "Match": {
          "Path": "/api/customers/{**catch-all}"
        }
      },
      "contacts-route": {
        "ClusterId": "contacts-cluster",
        "AuthorizationPolicy": "Default",
        "RateLimiterPolicy": "gateway",
        "Match": {
          "Path": "/api/contacts/{**catch-all}"
        }
      },
      "deals-route": {
        "ClusterId": "sales-cluster",
        "AuthorizationPolicy": "Default",
        "RateLimiterPolicy": "gateway",
        "Match": {
          "Path": "/api/deals/{**catch-all}"
        }
      },
      "tasks-route": {
        "ClusterId": "tasks-cluster",
        "AuthorizationPolicy": "Default",
        "RateLimiterPolicy": "gateway",
        "Match": {
          "Path": "/api/tasks/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-destination": {
            "Address": "http://relatio-identity:8080"
          }
        }
      },
      "customers-cluster": {
        "Destinations": {
          "customers-destination": {
            "Address": "http://relatio-customers:8080"
          }
        }
      },
      "contacts-cluster": {
        "Destinations": {
          "contacts-destination": {
            "Address": "http://relatio-contacts:8080"
          }
        }
      },
      "sales-cluster": {
        "Destinations": {
          "sales-destination": {
            "Address": "http://relatio-sales:8080"
          }
        }
      },
      "tasks-cluster": {
        "Destinations": {
          "tasks-destination": {
            "Address": "http://relatio-tasks:8080"
          }
        }
      }
    }
  }
}
